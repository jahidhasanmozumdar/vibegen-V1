# =============================================================================
# VibeGen Studio — environment reference (copy to .env; never commit real values)
# =============================================================================

# --- Database: PostgreSQL via Prisma ORM 7 + @prisma/adapter-pg -----------------
# Any Postgres works: Supabase (used as plain Postgres), AWS RDS, Neon, or a VPS.
# Without DATABASE_URL the site falls back to a local JSON demo store (.data/).
#
# Runtime connection. A pooled URL is fine (Supabase :6543, PgBouncer, RDS Proxy).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
# Direct (non-pooled) connection for migrations and seeding.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# require = encrypted, cert not verified (Supabase/RDS) · verify = strict (+ DATABASE_CA_CERT)
# disable = no TLS (Postgres on the same host/private network)
DATABASE_SSL=require
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n..."   # only with DATABASE_SSL=verify
DATABASE_POOL_MAX=5

# First-time setup (and on every deploy for migrations):
#   pnpm install          # also generates the Prisma client (lib/generated, git-ignored)
#   pnpm db:deploy        # prisma migrate deploy (or `pnpm db:apply` where Prisma's engine can't run)
#   pnpm db:seed          # admin account + starter content + demo data (safe to re-run)

# --- Site ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://vibegen.studio
# true shows the demo-login hint on /admin/login (local JSON mode only).
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=

# --- Admin accounts -----------------------------------------------------------------
# Signs the httpOnly admin session cookie. 48+ random characters:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET=
# First admin, created by `pnpm db:seed` (password >= 10 chars). More users:
#   pnpm admin:create person@company.com "Full Name" manager
ADMIN_EMAIL=
ADMIN_NAME=Studio Admin
ADMIN_PASSWORD=
# Set to true for one seed run to overwrite an existing admin's password.
# ADMIN_PASSWORD_RESET=false
# Seed demo CRM data (flagged is_demo, removable in Admin → Settings → Data).
# SEED_DEMO=true

# Local JSON demo mode only (no DATABASE_URL):
DEMO_ADMIN_EMAIL=admin@vibegen.studio
DEMO_ADMIN_PASSWORD=
LOCAL_DATA_FILE=vibegen-db.json

# --- Email (lead notifications, password reset links) -------------------------------
# console (logs only) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="VibeGen Studio <hello@vibegen.studio>"
ADMIN_NOTIFICATION_EMAIL=

# --- Booking webhook (Calendly / Cal.com) --------------------------------------------
BOOKING_WEBHOOK_SECRET=

# --- Tracking (public IDs only) ------------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_AUDIT_LABEL=

# --- Instant Funnel Scan (homepage) ---------------------------------------------------
# Real-browser scan needs Chrome/Chromium on the server (empty = auto-detect).
# Linux: apt install chromium  →  /usr/bin/chromium
CHROME_EXECUTABLE_PATH=
FREE_SCANS_PER_DAY=3
